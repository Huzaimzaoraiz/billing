{
  "name": "coaching-billing-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready SQL billing platform for multi-branch coaching institutes.",
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "PORT=3000 nodemon backend/server.js",
    "dev:frontend": "vite frontend --host 127.0.0.1 --port 5173",
    "start": "node backend/server.js",
    "build": "prisma generate && vite build frontend",
    "preview": "vite preview frontend --host 127.0.0.1 --port 4173",
    "check": "node --check backend/config.js && node --check backend/database.js && node --check backend/app.js && node --check backend/server.js && node --check backend/routes/auth.js && node --check backend/routes/billing.js && node --check backend/routes/branches.js && node --check backend/routes/courses.js && node --check backend/routes/dashboard.js && node --check backend/routes/students.js && node --check backend/routes/users.js && vite build frontend"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@clerk/express": "^2.1.55",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tanstack/react-query": "^5.59.20",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7",
    "prisma": "^7.9.1",
    "vite": "^6.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
