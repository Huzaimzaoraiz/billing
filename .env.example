# Copy this file to `.env` and fill values before running the app.
# Database (Postgres)
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mydb
DB_USER=postgres
DB_PASS=YourSecurePassword
DB_ENCRYPT=false
DB_SYNC_ALTER=false
DB_SYNC_FORCE=false

# App / Auth
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXP=1h
AUTH_COOKIE_NAME=auth_token
FRONTEND_URL=http://127.0.0.1:5173,http://localhost:5173

# Frontend branding and number formatting
VITE_APP_NAME=Institute Billing
VITE_LOCALE=en-IN
VITE_CURRENCY=INR

# Used only when creating the very first super administrator.
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.example
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_initial_password

# Server
PORT=3001
