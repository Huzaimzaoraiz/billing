# Copy this file to `.env` and fill values before running the app.
# Database (SQL Server)
DB_DIALECT=mssql
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=billing_db
DB_USER=sa
DB_PASS=YourStrong@Password123
DB_ENCRYPT=false
# Optional: DB_INSTANCE=SQLEXPRESS

# App / Auth
ADMIN_PASSWORD=admin
JWT_SECRET=replace_with_a_strong_secret
JWT_EXP=1h
AUTH_COOKIE_NAME=auth_token

# Server
PORT=3000
